# ============================================================
#  BITUNIX AI AGENT TRADER  —  environment
#  LIVE TRADING ONLY. There is no dry-run mode in this project.
# ============================================================

# ---------- AI ----------
# AUTO = try every provider that has a key, in order, with auto failover
AI_PROVIDER=AUTO

# OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, DeepSeek, Together, LM Studio, vLLM ...)
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_URL=https://api.openai.com/v1
# AUTO = autoSetModelByKey() -> asks /models and picks the best reasoning model available to your key
OPENAI_COMPATIBLE_MODEL=AUTO

# Google Gemini
GEMINI_GOOGLE_KEY=
GEMINI_GOOGLE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_GOOGLE_MODEL=AUTO

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=AUTO

# ---------- Neon (long term memory) ----------
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---------- Bitunix Futures ----------
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE=wss://fapi.bitunix.com/private/
MARGIN_COIN=USDT

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# only these chat ids may command the agent (comma separated)
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------- Agent ----------
AGENT_NAME=ARIA
AGENT_AUTONOMOUS_SEC=15
THINKING_LEVEL=high
AUTOCOMPACT=true
AUTO_REFRESH_MODEL=true
MCP_ENABLED=true
# Dream: off-hours reflection on the agent's own closed trades. It writes
# lessons back to long-term memory and never places an order.
DREAM_ENABLED=false
DREAM_INTERVAL_HOURS=24

# ---------- Trading defaults (all changeable at runtime with /set) ----------
LEVERAGE=10
MARGIN_MODE=CROSS
POSITION_MODE=HEDGE
ORDER_UNIT=COST
MARGIN_PCT=5
SCAN_INTERVAL_SEC=15
MANAGE_INTERVAL_SEC=15
GUARD_INTERVAL_SEC=15
REPORT_INTERVAL_SEC=30
MIN_AGREEMENT=2
MIN_CONFIDENCE=80
TF_MIN_CONFIDENCE=60
SIGNAL_CONFIRM_SCANS=1
COOLDOWN_MIN=5
REVERSAL_ENABLED=true
REVERSAL_CONFIDENCE=85
BREAKEVEN_THRESHOLD=20
TRAILING_TRIGGER_ROI_PCT=25
# How far behind price the trailing stop sits, in ATR
TRAILING_DISTANCE_ATR=0.5
# Safety gap kept between the stop and the liquidation price, as a fraction of
# the entry->liq distance. 0.50 = the stop may use at most half that distance.
LIQ_DISTANCE=0.50

# --- the four TP/SL methods (help centre id=290) ---
# POSITION = one TP/SL for the whole position. PARTIAL = scale-out ladder too.
# ADAPTIVE = target chosen from trend strength/structure; FIXED_R = multiple of the stop
TP_MODE=ADAPTIVE
TPSL_METHOD=POSITION
# share@R pairs; shares sum to <=100, the remainder rides as a runner
PARTIAL_TP_LADDER=40@1,35@2,25@3
# ATR = N ATR behind price. RATIO = % callback from best. INTERVAL = absolute.
TRAILING_METHOD=ATR
TRAILING_CALLBACK=1.5
# close every position on total unrealised PnL; 0 = off
ACCOUNT_TP_USDT=0
ACCOUNT_SL_USDT=0
MAX_OPEN_POSITIONS=5
UNIVERSE_SIZE=40
# Liquidity floor: pairs thinner than this are never scanned
# VOLUME | GAINERS | LOSERS | MOVERS — how the universe is ordered
UNIVERSE_RANK=VOLUME
MIN_24H_VOLUME_USD=20000000
AUTO_TRADE=true
